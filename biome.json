{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/public",
      "!**/playwright-report",
      "!**/test-results",
      "!**/packages/db/drizzle",
      "!**/contracts/lib"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      }
    },
    "domains": {
      "react": "recommended",
      "next": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/bare-metal/**",
        "apps/agent/**",
        "apps/facilitator/**",
        "packages/metal-db/**",
        "packages/metal-shared/**",
        "packages/metal-scripts/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false
          },
          "complexity": {
            "useLiteralKeys": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useConsistentTypeDefinitions": "off",
            "useNodejsImportProtocol": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noConfusingVoidType": "off",
            "noExplicitAny": "off",
            "noShadowRestrictedNames": "off",
            "noSuspiciousSemicolonInJsx": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/*/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**"],
                    "message": "Features cannot import other features. Use relative imports inside the feature, or hoist shared code to src/shared or packages/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
