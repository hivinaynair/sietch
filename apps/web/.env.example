# Live clip: the click submits settle() / publishInbound on Base Sepolia.
# Without these, the room plays the recorded tape (e2e, local without a key).
# SIETCH_LIVE=0 forces the tape even when a key is present.
SIETCH_CLERK_PRIVATE_KEY=
SIETCH_DESK_ADDRESS=
SIETCH_RPC_URL=https://sepolia.base.org
SIETCH_LIVE=1
# Optional. Public RPCs cap eth_getLogs at 10k blocks; default is latest − 9000.
SIETCH_FROM_BLOCK=
