# Live clip: the click submits settle() / publishInbound on Base Sepolia.
# Without these, the room stays idle and the control is disarmed.
# SIETCH_LIVE=0 forces tape mode (e2e).
SIETCH_CLERK_PRIVATE_KEY=
SIETCH_DESK_ADDRESS=
SIETCH_RPC_URL=https://sepolia.base.org
SIETCH_LIVE=1
# Optional. Public RPCs cap eth_getLogs at 10k blocks; default is the desk deploy block.
SIETCH_FROM_BLOCK=
